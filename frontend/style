body {
  font-family: Arial, sans-serif;
  background: #f4f6f8;
}

.container {
  max-width: 600px;
  margin: 40px auto;
  background: #fff;
  padding: 24px;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

button {
  background: #3b82f6;
  color: #fff;
  border: none;
  padding: 8px 14px;
  border-radius: 6px;
  cursor: pointer;
  margin: 4px 0;
}

input {
  padding: 8px;
  width: 65%;
}

ul { padding-left: 20px; }
li { margin: 8px 0; }
li.done { color: #16a34a; }

#status {
  margin-top: 12px;
  font-weight: bold;
}